{
  "name": "poetic-realm",
  "version": "1.1.0",
  "private": true,
  "description": "PoeticRealm - 诗意生活相册 | AI驱动的意义创作平台",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.sqlite.prisma",
    "db:studio": "prisma studio --schema prisma/schema.sqlite.prisma"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.0.24",
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^5.10.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.0.1",
    "@radix-ui/react-tabs": "^1.0.4",
    "@vercel/blob": "^0.23.4",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.344.0",
    "nanoid": "^5.0.6",
    "next": "14.1.0",
    "next-auth": "^4.24.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "postcss": "^8.4.33",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
