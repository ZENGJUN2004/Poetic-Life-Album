# ============================================
# PoeticRealm 环境配置示例
# 复制此文件为 .env.local 并填入实际值
# ============================================

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# 数据库 - 使用 SQLite 开发，生产环境建议 PostgreSQL
DATABASE_URL="file:./dev.db"

# AI API 配置
# 推荐使用智谱（国内直连、有免费视觉模型）
# API Key 申请: 登录 https://open.bigmodel.cn/ 后访问
#   https://bigmodel.cn/usercenter/proj-mgmt/apikeys
MODEL_PROVIDER=zhipu
ZHIPU_API_KEY=your-zhipu-api-key

# 默认模型（均为免费模型）
# 视觉: glm-4.6v-flash (128K ctx, 32K out, 支持视觉推理)
# 文本: glm-4.7-flash  (200K ctx, 128K out, 通用对话+写作)
VISION_MODEL=glm-4.6v-flash
WRITER_MODEL=glm-4.7-flash
PLANNER_MODEL=glm-4.7-flash

# 可选：其他模型供应商（保留向后兼容，ZHIPU_API_KEY 优先级最高）
# GEMINI_API_KEY=your-gemini-api-key   # 需翻墙
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# 对象存储（生产环境使用）
# STORAGE_PROVIDER=cloudflare
# CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
# CLOUDFLARE_R2_BUCKET=poetic-realm

# 本地存储路径（开发环境）
LOCAL_STORAGE_PATH=./public/uploads

# Redis（可选，用于缓存和队列）
# REDIS_URL=redis://localhost:6379

# 邮件服务（可选）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASSWORD=your-password

# 分析工具（可选）
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
