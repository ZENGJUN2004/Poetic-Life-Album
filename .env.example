# ============================================
# PoeticRealm 环境配置示例
# 复制此文件为 .env.local 并填入实际值
# ============================================

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# 数据库 - 使用 SQLite 开发，生产环境建议 PostgreSQL
DATABASE_URL="file:./dev.db"

# AI API 配置
# 支持多种模型供应商，通过 MODEL_PROVIDER 切换
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key

# 可选：其他模型供应商
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key

# 默认模型配置
VISION_MODEL=openrouter/claude-3-opus
WRITER_MODEL=openrouter/claude-3-opus
PLANNER_MODEL=openrouter/claude-3-sonnet

# 对象存储（生产环境使用）
# STORAGE_PROVIDER=cloudflare
# CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
# CLOUDFLARE_R2_BUCKET=poetic-realm

# 本地存储路径（开发环境）
LOCAL_STORAGE_PATH=./public/uploads

# Redis（可选，用于缓存和队列）
# REDIS_URL=redis://localhost:6379

# 邮件服务（可选）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASSWORD=your-password

# 分析工具（可选）
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
