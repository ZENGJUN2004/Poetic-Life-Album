// ============================================
// Prisma Schema - PostgreSQL (Vercel 生产环境)
// 本地开发请使用 schema.prisma (SQLite)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户系统 ====================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatar        String?
  bio           String?
  poeticDNA     String?
  meaningScore  Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  photos        Photo[]
  poems         Poem[]
  creativeSessions CreativeSession[]
  knowledgeEntries KnowledgeEntry[]
  aiInteractions AIInteraction[]
  collections   Collection[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==================== 照片系统 ====================
model Photo {
  id          String    @id @default(cuid())
  userId      String
  url         String
  thumbnailUrl String?
  caption     String?
  takenAt     DateTime?
  location    String?
  isAnalyzed  Boolean   @default(false)
  isPrivate   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis    PhotoAnalysis?
  poems       Poem[]
  creativeSessions CreativeSession[]

  @@index([userId])
  @@map("photos")
}

model PhotoAnalysis {
  id            String   @id @default(cuid())
  photoId       String   @unique
  dominantColors String?
  objects       String?
  scenes        String?
  emotions      String?
  composition   String?
  aestheticScore Float?
  aiModel       String
  analyzedAt    DateTime @default(now())

  photo         Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@map("photo_analyses")
}

// ==================== 创作状态机（CSM）====================
model CreativeSession {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("UPLOADING")
  mode          String    @default("FREE")
  currentStep   Int       @default(0)
  title         String?
  meaning       String?
  meaningConfirmed Boolean @default(false)
  userNote      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos        Photo[]
  poem          Poem?
  steps         SessionStep[]
  aiInteractions AIInteraction[]

  @@index([userId, status])
  @@map("creative_sessions")
}

model SessionStep {
  id          String   @id @default(cuid())
  sessionId   String
  stepNumber  Int
  stepType    String
  input       String?
  output      String?
  status      String   @default("pending")
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?
  aiModel     String?
  errorMsg    String?

  session     CreativeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_steps")
}

// ==================== 诗歌系统 ====================
model Poem {
  id            String    @id @default(cuid())
  userId        String
  sessionId     String?   @unique
  title         String
  content       String
  style         String?
  emotion       String?
  imagery       String?
  meaning       String?
  language      String    @default("zh")
  lineCount     Int
  wordCount     Int
  characterCount Int
  qualityScore  Float?
  isDraft       Boolean   @default(false)
  isPublic      Boolean   @default(false)
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)
  shareCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       CreativeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  photos        Photo[]
  revisions     PoemRevision[]
  explainCard   ExplainCard?

  @@index([userId])
  @@index([isPublic])
  @@map("poems")
}

model PoemRevision {
  id          String   @id @default(cuid())
  poemId      String
  version     Int
  content     String
  title       String
  changedBy   String   @default("ai")
  changeNote  String?
  createdAt   DateTime @default(now())

  poem        Poem     @relation(fields: [poemId], references: [id], onDelete: Cascade)

  @@unique([poemId, version])
  @@map("poem_revisions")
}

model ExplainCard {
  id            String   @id @default(cuid())
  poemId        String   @unique
  meaningExplain String?
  imagerySource String?
  styleGuide    String?
  creativePath  String?
  generatedAt   DateTime @default(now())

  poem          Poem     @relation(fields: [poemId], references: [id], onDelete: Cascade)

  @@map("explain_cards")
}

// ==================== 意义知识体系（MKG）====================
model KnowledgeEntry {
  id          String         @id @default(cuid())
  userId      String?
  type        String
  key         String
  title       String
  content     String
  tags        String?
  references  String?
  usageCount  Int            @default(0)
  isVerified  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([type, key])
  @@index([type])
  @@map("knowledge_entries")
}

// ==================== AI交互记录 ====================
model AIInteraction {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String?
  interactionType String
  prompt        String
  response      String?
  aiModel       String
  tokenUsage    Int?
  duration      Int?
  status        String   @default("success")
  errorMsg      String?
  metadata      String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       CreativeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([interactionType])
  @@map("ai_interactions")
}

// ==================== 诗集/相册 ====================
model Collection {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  coverImage  String?
  type        String    @default("poem")
  poemIds     String?
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("collections")
}

// ==================== 系统配置 ====================
model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
