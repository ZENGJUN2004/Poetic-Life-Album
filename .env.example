# ============================================
# PoeticRealm 环境配置示例
# 复制此文件为 .env.local 并填入实际值
# ============================================

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# 数据库 - 使用 SQLite 开发，生产环境建议 PostgreSQL
DATABASE_URL="file:./dev.db"

# AI API 配置
# 推荐使用 Google Gemini Vision（免费额度充足，支持真正的视觉识别）
# 申请地址: https://aistudio.google.com/apikey
MODEL_PROVIDER=google
GEMINI_API_KEY=your-gemini-api-key

# 默认模型 — Gemini 2.0 Flash 支持视觉+文本，速度快、免费
VISION_MODEL=gemini-2.0-flash
WRITER_MODEL=gemini-2.0-flash
PLANNER_MODEL=gemini-2.0-flash

# 可选：其他模型供应商（保留向后兼容，GEMINI_API_KEY 优先级最高）
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# 对象存储（生产环境使用）
# STORAGE_PROVIDER=cloudflare
# CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
# CLOUDFLARE_R2_BUCKET=poetic-realm

# 本地存储路径（开发环境）
LOCAL_STORAGE_PATH=./public/uploads

# Redis（可选，用于缓存和队列）
# REDIS_URL=redis://localhost:6379

# 邮件服务（可选）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASSWORD=your-password

# 分析工具（可选）
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
